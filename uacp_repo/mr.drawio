<mxfile host="app.diagrams.net">
  <diagram id="provRuntime" name="Provisioning vs Runtime (Orbit Style)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- Core Hub -->
        <mxCell id="gateway" value="U‑ACP/MCP Gateway (Core)" style="ellipse;shape=ellipse;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="300" width="150" height="150" as="geometry"/>
        </mxCell>

        <!-- Registry (attached) -->
        <mxCell id="registry" value="Registry (Runtime SoR)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="150" height="80" as="geometry"/>
        </mxCell>

        <!-- Marketplace (catalog/discovery only) -->
        <mxCell id="market" value="Marketplace (Discovery/Admin)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="780" y="180" width="180" height="80" as="geometry"/>
        </mxCell>

        <!-- Producer (Dev + CI/CD) -->
        <mxCell id="dev" value="Developer / ADK + CI/CD" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="180" height="70" as="geometry"/>
        </mxCell>

        <!-- Admin Consumer (Portal for entitlements) -->
        <mxCell id="portal_admin" value="Broker/Employer Portal (Admin Plane)" style="rounded=1;whiteSpace=wrap;fillColor=#fce5cd;strokeColor=#e69138;" vertex="1" parent="1">
          <mxGeometry x="250" y="150" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Runtime Consumer (Portal Application) -->
        <mxCell id="portal_rt" value="Broker/Employer Application (Runtime)" style="rounded=1;whiteSpace=wrap;fillColor=#f4cccc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="250" y="40" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Agents orbiting -->
        <mxCell id="agent1" value="Enrollment Agent" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="200" y="520" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="agent2" value="Commissions Agent" style="ellipse;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="540" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="agent3" value="Reporting Agent" style="ellipse;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="660" y="500" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Data connectors -->
        <mxCell id="data" value="Data Connectors (Scoped Secrets, Policy‑Guarded)" style="rounded=1;whiteSpace=wrap;fillColor=#f2f2f2;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="320" y="640" width="400" height="60" as="geometry"/>
        </mxCell>

        <!-- Observability foundation -->
        <mxCell id="obs" value="Observability: LingoScope → Dynatrace Davis AI&#10;Traces • Tokens • Latency • Cost • Kill Switch" style="rounded=1;whiteSpace=wrap;fillColor=#cce5ff;strokeColor=#4a90e2;" vertex="1" parent="1">
          <mxGeometry x="200" y="740" width="600" height="70" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend:&#10;Dashed = Provisioning/Admin Plane&#10;Solid = Runtime Invocation&#10;Dotted = Telemetry/Observability" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="820" y="640" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- Edges: Provisioning/Admin (dashed) -->
        <mxCell id="e1" style="endArrow=block;strokeColor=#000000;dashed=1;" edge="1" parent="1" source="dev" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;strokeColor=#000000;dashed=1;" edge="1" parent="1" source="gateway" target="market"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;strokeColor=#000000;dashed=1;" edge="1" parent="1" source="portal_admin" target="market"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;strokeColor=#000000;dashed=1;" edge="1" parent="1" source="market" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Edges: Runtime (solid) -->
        <mxCell id="r1" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="portal_rt" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="gateway" target="agent1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="gateway" target="agent2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="gateway" target="agent3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r5" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="agent1" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r6" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="agent2" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r7" style="endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="agent3" target="data"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Telemetry edges (dotted) -->
        <mxCell id="t1" style="endArrow=block;strokeColor=#000000;dotted=1;" edge="1" parent="1" source="gateway" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2" style="endArrow=block;strokeColor=#000000;dotted=1;" edge="1" parent="1" source="agent1" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t3" style="endArrow=block;strokeColor=#000000;dotted=1;" edge="1" parent="1" source="agent2" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t4" style="endArrow=block;strokeColor=#000000;dotted=1;" edge="1" parent="1" source="agent3" target="obs"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
